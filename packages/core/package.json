{
  "name": "@celeste/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Celeste agent runtime: planner, executor, memory, checkpoints and guardrails.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@celeste/gateway": "workspace:*",
    "@celeste/protocol": "workspace:*",
    "@celeste/tools": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
