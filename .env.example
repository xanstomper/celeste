# ─────────────────────────────────────────────────────────────────────────────
# Celeste configuration
#
# Copy to ~/.celeste/.env and source it, or export these directly.
# Celeste auto-discovers providers from the variables below — no config file
# is required for the common case.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloud model providers (use whichever you have) ──────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
TOGETHER_API_KEY=
SILICONFLOW_API_KEY=

# ── Local inference ─────────────────────────────────────────────────────────
# Ollama is auto-detected. Override the host or pick a different model:
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# LM Studio / llama.cpp / vLLM (OpenAI-compatible servers)
LMSTUDIO_API_KEY=
LLAMACPP_API_KEY=

# ── Optional overrides ──────────────────────────────────────────────────────
# CELESTE_CONFIG=/path/to/celeste.config.json
# CELESTE_OUTPUT_DIR=$HOME/Documents/Celeste
# CELESTE_DATA_DIR=$HOME/.celeste/data
